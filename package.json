{
    "name": "nestjs-redis-cache",
    "version": "3.1.3",
    "description": "A NestJS-compatible Redis caching package with explicit caching decorators",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc --watch",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky install",
        "prepublishOnly": "npm run build",
        "release": "standard-version",
        "release:minor": "standard-version --release-as minor",
        "release:major": "standard-version --release-as major",
        "release:patch": "standard-version --release-as patch",
        "publish:release": "npm run release && git push --follow-tags origin $(git rev-parse --abbrev-ref HEAD) && npm publish --access public"
    },
    "keywords": [
        "nestjs",
        "redis",
        "cache",
        "caching",
        "decorators",
        "typescript"
    ],
    "author": "hmake98",
    "license": "MIT",
    "peerDependencies": {
        "@nestjs/common": "^8.0.0 || ^9.0.0 || ^10.0.0",
        "ioredis": "^5.0.0",
        "reflect-metadata": "^0.1.13"
    },
    "devDependencies": {
        "@eslint/js": "^9.33.0",
        "@nestjs/common": "^10.0.0",
        "@nestjs/core": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@types/jest": "^29.5.0",
        "@types/node": "^18.0.0",
        "@typescript-eslint/eslint-plugin": "^8.40.0",
        "@typescript-eslint/parser": "^8.40.0",
        "eslint": "^9.33.0",
        "eslint-config-prettier": "^9.1.2",
        "globals": "^15.15.0",
        "husky": "^8.0.0",
        "ioredis": "^5.3.0",
        "ioredis-mock": "^8.9.0",
        "jest": "^29.5.0",
        "lint-staged": "^15.5.2",
        "prettier": "^3.6.2",
        "reflect-metadata": "^0.1.13",
        "standard-version": "^9.5.0",
        "ts-jest": "^29.1.0",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.40.0"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "collectCoverageFrom": [
            "src/**/*.ts",
            "!src/**/*.spec.ts",
            "!src/**/*.d.ts"
        ]
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css,scss}": [
            "prettier --write"
        ]
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ]
}
